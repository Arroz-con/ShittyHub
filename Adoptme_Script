            local Clipboard = {}
            local localPlayer = Players.LocalPlayer
            local getPlayerData = function()
                return ClientData.get_data()[localPlayer.Name]
            end
            local incrementCount = function(counts, id)
                counts[id] = (counts[id] or 0) + 1
            end
            local countInventoryItems = function(items)
                local counts = {}

                for _, item in items do
                    if item.id ~= 'practice_dog' then
                        incrementCount(counts, item.id)
                    end
                end

                return counts
            end
            local getDatabaseNames = function(categoryName)
                local names = {}

                for _, item in InventoryDB[categoryName]do
                    names[tostring(item.id)] = item.name
                end

                return names
            end
            local formatInventoryCounts = function(categoryName, counts)
                local lines = {}
                local names = getDatabaseNames(categoryName)

                for itemId, count in counts do
                    local itemName = names[itemId]

                    if itemName then
                        table.insert(lines, string.format('[%s] %s x%s\n', tostring(string.upper(categoryName)), tostring(itemName), tostring(count)))
                    end
                end

                return table.concat(lines)
            end
            local countPetVariants = function(pets)
                local counts = {
                    mega = {},
                    neon = {},
                    normal = {},
                }
                local petNames = getDatabaseNames('pets')

                for _, pet in pets do
                    local petName = petNames[pet.id]

                    if not petName then
                        continue
                    end
                    if pet.properties.mega_neon then
                        incrementCount(counts.mega, petName)
                    end
                    if pet.properties.neon then
                        incrementCount(counts.neon, petName)
                    end
                    if not pet.properties.neon and not pet.properties.mega_neon then
                        incrementCount(counts.normal, petName)
                    end
                end

                return counts
            end
            local formatPetCounts = function(title, counts)
                local lines = {}

                for petName, count in counts do
                    table.insert(lines, string.format('%s%s x%s\n', tostring(title), tostring(petName), tostring(count)))
                end

                return table.concat(lines)
            end
            local countAgeUpPotions = function(food)
                local count = 0

                for _, item in food do
                    if item.id == 'pet_age_potion' then
                        count = count + 1
                    end
                end

                return count
            end
            local addComma = function(amount)
                local formatted = amount

                while true do
                    local replacements

                    formatted, replacements = string.gsub(formatted, '^(-?%d+)(%d%d%d)', '%1,%2')

                    if replacements == 0 then
                        return formatted
                    end
                end
            end
            local getBucksInfo = function(playerData)
                local potions = countAgeUpPotions(playerData.inventory.food)
                local bucks = playerData.money or 0
                local potionValue = string.format('%.2f', potions * 0.01)

                return string.format('%s Age-up Potions + %s Bucks | Adopt me\n', tostring(potions), tostring(addComma(tostring(bucks)))) .. string.format('sell for $%s  %s\n\n', tostring(potionValue), tostring(localPlayer.Name))
            end

            function Clipboard.GetAllInventoryData()
                local playerData = getPlayerData()
                local sections = {
                    getBucksInfo(playerData),
                }

                for _, categoryName in INVENTORY_CATEGORIES do
                    local counts = countInventoryItems(playerData.inventory[categoryName])

                    table.insert(sections, formatInventoryCounts(categoryName, counts))
                end

                return table.concat(sections)
            end
            function Clipboard.CopyDetailedPetInfo()
                local playerData = getPlayerData()
                local counts = countPetVariants(playerData.inventory.pets)

                return table.concat({
                    getBucksInfo(playerData),
                    formatPetCounts('[MEGA NEON] ', counts.mega),
                    formatPetCounts('[NEON] ', counts.neon),
                    formatPetCounts('[Normal] ', counts.normal),
                })
            end
            function Clipboard.GetIdsFromDatabase(categoryName)
                local category = InventoryDB[categoryName]

                if not category then
                    return ''
                end

                local lines = {
                    DATABASE_DIVIDER,
                    string.format('\n                    %s                    \n', tostring(string.upper(categoryName))),
                    DATABASE_DIVIDER,
                    '\n',
                }

                for id in category do
                    table.insert(lines, string.format('%s\n', tostring(id)))
                end

                return table.concat(lines)
            end

            return Clipboard
        end

